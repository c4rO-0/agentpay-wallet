{
  "name": "@c4roa0/agentpay-wallet",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentpay-wallet": "bin/agentpay-wallet.mjs"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "build:package": "node scripts/build-package.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "@c4roa0/agentpay-protocol": "0.14.3"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "typescript": "7.0.2"
  },
  "description": "Local Wallet service and capability-scoped client for bounded AgentPay payments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c4rO-0/agentpay-wallet.git"
  },
  "homepage": "https://github.com/c4rO-0/agentpay-wallet#readme",
  "bugs": {
    "url": "https://github.com/c4rO-0/agentpay-wallet/issues"
  },
  "main": "./lib/client.js",
  "types": "./lib/client.d.ts",
  "exports": {
    ".": {
      "types": "./lib/client.d.ts",
      "import": "./lib/client.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "import": "./lib/client.js"
    },
    "./local": {
      "types": "./lib/local.d.ts",
      "import": "./lib/local.js"
    },
    "./cli": "./bin/agentpay-wallet.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "bin/agentpay-wallet.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "doc/usage.md",
    "doc/reference/local-ipc.md",
    "doc/reference/public-package.md"
  ]
}
